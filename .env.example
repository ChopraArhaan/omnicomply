# ==============================================================================
# OmniComply — Environment Variables
# Copy this file to .env and fill in the values
# ==============================================================================

# ---- LLM Configuration ----
LLM_PROVIDER=huggingface                     # huggingface | openai | together | vllm
LLM_MODEL_NAME=meta-llama/Llama-3.1-70B-Instruct
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=                                 # Override for vLLM or custom endpoint
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ---- Embedding Configuration ----
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu                          # cpu | cuda
EMBEDDING_BATCH_SIZE=32

# ---- PostgreSQL + pgvector ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omnicomply
POSTGRES_USER=omnicomply
POSTGRES_PASSWORD=omnicomply_dev_password
DATABASE_URL=postgresql+asyncpg://omnicomply:omnicomply_dev_password@localhost:5432/omnicomply

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- API Configuration ----
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# ---- External Data APIs ----
FEDERAL_REGISTER_API_URL=https://www.federalregister.gov/api/v1
SEC_EDGAR_API_URL=https://efts.sec.gov/LATEST
FDA_API_URL=https://api.fda.gov
CONGRESS_API_KEY=your-congress-api-key

# ---- Observability ----
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=omnicomply
LANGSMITH_TRACING_V2=true
LOG_LEVEL=INFO

# ---- Eval Configuration ----
EVAL_FAITHFULNESS_THRESHOLD=0.90
EVAL_RELEVANCY_THRESHOLD=0.85
EVAL_CONTEXT_PRECISION_THRESHOLD=0.80
EVAL_GOLDEN_DATASET_PATH=eval/datasets/regulatory_qa_golden.jsonl

# ---- RAG Configuration ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
SEMANTIC_CACHE_THRESHOLD=0.92

